pragma solidity ^0.8.0;

import 'src/KSDistributor.sol';
import 'src/interfaces/IKSZapRouter.sol';

import '../mocks/ERC721Mock.sol';
import '../utils/MerkleUtils.sol';

import 'forge-std/Test.sol';

contract ZapRewardsTest is Test {
  using MerkleUtils for bytes32[];

  uint256 constant FORK_BLOCK_NUMBER = 22_629_679;

  address public owner = makeAddr('owner');
  address public operator = makeAddr('operator');
  address public guardian = makeAddr('guardian');
  address public rescuer = makeAddr('rescuer');
  address public alice = makeAddr('alice');

  KSDistributor public distributor;

  bytes zapCalldata =
    hex'';

  address weth = 0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2;
  uint256 wethAmount = 100_000_000_000_000_000;
  address usdc = 0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48;
  uint256 usdcAmount = 500_000_000;

  address zapRouter = 0x0e97C887b61cCd952a53578B04763E7134429e05;
  address zapExecutor = 0x63b0a0d33FE906C668b1DE4875Bfaf562A9D8c5b;

  function setUp() public {
    vm.createSelectFork('mainnet', FORK_BLOCK_NUMBER);

    address[] memory initialOperators = new address[](1);
    initialOperators[0] = operator;
    address[] memory initialGuardians = new address[](1);
    initialGuardians[0] = guardian;
    address[] memory initialRescuers = new address[](1);
    initialRescuers[0] = rescuer;

    address[] memory hooks = new address[](1);
    hooks[0] = address(zapRouter);
    bytes4[] memory selectors = new bytes4[](1);
    selectors[0] = IKSZapRouter.zap.selector;

    distributor = new KSDistributor(
      owner, initialOperators, initialGuardians, initialRescuers, hooks, selectors, 0
    );

    deal(weth, address(distributor), wethAmount);
    deal(usdc, address(distributor), usdcAmount);
  }

  /// forge-config: default.fuzz.runs = 10
  function test_zapRewards(uint256 seed) public {
    bytes32 campaignId;
    KSDistributor.Campaign memory campaign;

    (campaignId, campaign) = _createCampaign(seed);
    (bytes32[] memory leaves,) = _setUpRewards(campaignId);

    vm.warp(campaign.startTimestamp + distributor.defaultTimeLock() + 1);

    bytes32[] memory proof = leaves.getProof(0);
    address[] memory tokens = new address[](2);
    tokens[0] = weth;
    tokens[1] = usdc;
    uint256[] memory amounts = new uint256[](2);
    amounts[0] = wethAmount;
    amounts[1] = usdcAmount;

    (IKSZapRouter.ZapDescription memory zapDesc, IKSZapRouter.ZapExecutionData memory zapExe) =
      abi.decode(zapCalldata, (IKSZapRouter.ZapDescription, IKSZapRouter.ZapExecutionData));
    IKSZapRouter.ERC20SrcInfo memory srcInfo =
      IKSZapRouter.ERC20SrcInfo({tokens: new address[](1), amounts: new uint256[](1)});
    srcInfo.tokens[0] = weth;
    zapDesc.srcInfo = abi.encode(srcInfo);

    zapExe.deadline = uint32(block.timestamp + 100);

    vm.prank(alice);
    distributor.claimRewardsForAccountWithHook(
      campaignId,
      tokens,
      amounts,
      proof,
      zapExecutor,
      address(zapRouter),
      abi.encodeCall(IKSZapRouter.zap, (zapDesc, zapExe))
    );
  }

  function _createCampaign(uint256 seed)
    internal
    returns (bytes32 campaignId, KSDistributor.Campaign memory campaign)
  {
    campaign.startTimestamp = block.timestamp + 1;
    campaign.endTimestamp = campaign.startTimestamp + bound(seed, 1 days, 1 days);
    campaign.metadata = 'metadata';
    vm.prank(operator);
    campaignId = distributor.createCampaign(
      campaign.startTimestamp, campaign.endTimestamp, campaign.metadata, bytes32(0)
    );
  }

  function _setUpRewards(bytes32 campaignId)
    internal
    returns (bytes32[] memory leaves, bytes32 root)
  {
    leaves = new bytes32[](1);
    bytes32 infoHash = keccak256(abi.encode(campaignId, alice));

    address[] memory tokens = new address[](2);
    tokens[0] = weth;
    tokens[1] = usdc;
    uint256[] memory amounts = new uint256[](2);
    amounts[0] = wethAmount;
    amounts[1] = usdcAmount;

    leaves[0] = keccak256(bytes.concat(keccak256(abi.encode(infoHash, tokens, amounts))));

    root = leaves.getRoot();
    vm.prank(operator);
    distributor.submitRoot(campaignId, root, 0);
  }
}
